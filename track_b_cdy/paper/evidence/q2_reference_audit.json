      "id": "q2-eq-normal-thickness",
      "code_function": "stresses",
      "equation": "sigma_n=rho*g*h_normal*cos(theta)/1000; tau=rho*g*h_normal*sin(theta)/1000 [kPa]",
      "paper_nuance": "h为坡面法向厚度；不能将垂直厚度直接代入同一式。"
    },
    {
      "id": "q2-eq-strength-mixing",
      "code_function": "resistance",
      "equation": "R=(1-D)*(f_b*c_b+(1-f_b)*c_j(T))+max(sigma_n-u,0)*(f_b*mu_b+(1-f_b)*mu_j(T))",
      "paper_nuance": "损伤只乘混合黏聚项；f_b是承载面积比例，区别于决定密度的岩石体积分数。"
    },
    {
      "id": "q2-eq-source-strength",
      "code_function": "joint_strength",
      "equation": "c_j=53.3-73.5*T [kPa]; mu_j=0.42-0.21*T; thaw challenger whenT>-.5: c=0,mu=.60",
      "paper_nuance": "Mamot为薄冰填石灰岩结构面快速剪切关系；有效应力替换、混合、损伤及暖端c=0/mu=.6均为模型情景扩展，不归为原文校准。"
    },
    {
      "id": "q2-eq-water-input",
      "code_function": "simulate",
      "equation": "Tsrc=air+offset; chi=clip((Tsrc+1)/2,0,1); I=rain_multiplier*P_mm_h*chi/1000+melt_mm_deg_day*max(Tsrc,0)/24000 [m/h]",
      "paper_nuance": "雨/融水用未截断的Tsrc，不能用B=min(Tsrc,0)替代正温融水项；H的融水边界不等于启用T内部导热。"
    },
    {
      "id": "q2-eq-water-state",
      "code_function": "simulate and reservoir_step",
      "equation": "dW/dt=I-W/tau_d-q_over; tau_d=tau0*exp(-kappa*D_i); Wcap=Sy*min(Hconn,.98*sigma_n/g); u=g*W/Sy [kPa]",
      "paper_nuance": "每小时I/tau_d取左端常数；储排水连续溢流采用分段解析积分，不是Euler。u简写使用rho_water=1000kg/m3与Pa到kPa换算抵消。"
    },
    {
      "id": "q2-eq-damage",
      "code_function": "simulate",
      "equation": "lambda=A*min(tau/max(R,1e-6),10)^n; Dnext=min(1-(1-D)*exp(-lambda*dt_h),.999999)",
      "paper_nuance": "稳定正裕度下仍可累积损伤；这是现象学应力比设计，不是由Mamot试验标定的慢蠕变率。"
    },
    {
      "id": "q2-eq-margin-and-censoring",
      "code_function": "resistance and classify_trajectory",
      "equation": "margin=(R-tau)/tau; first nonpositive after finite positive initial value uses adjacent-hour linear interpolation",
      "paper_nuance": "初始非正标left_censored，never_cross/missing单列；无压力根/负根/接触极限根及容量不可达需分开。后越阈继续轨迹为诊断。"
    },
    {
      "id": "q2-eq-analytic-causality",
      "code_function": "thermal_transfer_analytic and linear_causal_convolution",
      "equation": "DeltaB0=B0-Tinit; DeltaBj=Bj-Bj-1; K0=0; Kk=erfc(z/(2sqrt(alpha*k*dt_h*3600))); T[k]=Tinit+sum(j<k)DeltaBj*K[k-j]",
      "paper_nuance": "B_i=min(air_i+offset,0)作用[i,i+1)；nfft>=2nt-1排除循环卷积。state0指定初温，z=0时statek取B[k-1]左极限。"
    },
