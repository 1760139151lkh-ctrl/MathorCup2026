dmin:general-header:us7000tbwb-1787759497649:1787873798379","type":"general-header","code":"us7000tbwb-1787759497649","source":"admin","updateTime":1787873798379,"status":"UPDATE","properties":{"eventsource":"us","eventsourcecode":"7000tbwb","pdl-client-version":"Version 3.5.4 2026-01-22","review-status":"Reviewed","senderemail":"jpursley@usgs.gov"},"preferredWeight":1,"contents":{"":{"contentType":"1","lastModified":1787873798000,"length":658,"bytes":"<p class=\"alert info\">This event was initially reported as a magnitude 4.4 earthquake. Additional analysis of long period seismic waves indicate that the seismic energy was instead generated by a glacial collapse and debris flow. The location of this event was estimated from satellite images. About three hours after this event, a \n\n<a href=\"https://earthquake.usgs.gov/earthquakes/eventpage/us7000tc90/executive\">\nsecond landslide event \n</a>\noccurred in the region.\n\nFor more information see the\n<a href=\"https://www.usgs.gov/programs/landslide-hazards/science/2026-nepal-debris-avalanche-and-flash-flood\">\nUSGS landslides special event page. \n</a>\n\n</p>\n","sha256":"v+VwmZYCvBTeU3QLCJO8ZA1pbCcbHVD2Zo4vmS1ZYSo="}}}],"general-text":[{"indexid":28524176,"indexTime":1787770578705,"id":"urn:usgs-product:admin:general-text:us7000tbwb-1787769919148:1787770573664","type":"general-text","code":"us7000tbwb-1787769919148","source":"admin","updateTime":1787770573664,"status":"UPDATE","properties":{"eventsource":"us","eventsourcecode":"7000tbwb","pdl-client-version":"Version 3.5.4 2026-01-22","review-status":"Reviewed","senderemail":"wbarnhart@usgs.gov"},"preferredWeight":1,"contents":{"":{"contentType":"1","lastModified":1787770573000,"length":657,"bytes":"<h2>Key Points (updated Aug 26, 18:44 UTC)</h2>\n<ul>\n  <li>A magnitude 5.2 seismic event occurred near the border between Nepal and China on Aug 26 at 8:37 AM local time (10:52 AM China Standard Time).</li>\n<li>The USGS determined that the seismic event was a glacial collapse and debris flow that caused subsequent catastrophic impacts downstream.</li>\n<li>This event was initially reported as a magnitude 4.4 earthquake. Additional analysis of nearby seismic stations, long period seismic waves, and satellite imagery led to the determination that the seismic event was instead a glacial collapse and debris flow, and that no earthquake had occurred.</li>","sha256":"SsQdNre5XfYz95c1fYXsmdIH64d233Q7P2uxgyyY0lQ="}}}],"impact-text":[{"indexid":28729396,"indexTime":1792791426442,"id":"urn:usgs-product:us:impact-text:us7000tbwb:1792791413040","type":"impact-text","code":"us7000tbwb","source":"us","updateTime":1792791413040,"status":"UPDATE","properties":{"eventParametersPublicID":"quakeml:us.anss.org/eventparameters/7000tbwb/1792791415","eventsource":"us","eventsourcecode":"7000tbwb","pdl-client-version":"Version 3.6.0 2026-08-20"},"preferredWeight":8,"contents":{"":{"contentType":"text/plain","lastModified":1792791413000,"length":443,"bytes":"As of October 4, 2026, at least 1,455 people killed, 9,287 injured and 5,285 missing; 8,317 houses destroyed and extensive damage to bridge, road and power infrastructure in Nepal, including 109 bridges, 69 km of roads and 13 hydropower projects. At least 43 people killed and 519 missing, 27 buildings destroyed and communication, power and road access disrupted in Gyirong, China. The landslide location was obtained from satellite imagery.\n","sha256":"3zE8xF7FCu0O6pyFrLk8+fng6Y8mLdjNXFm0vNR8Wzw="}}}],"origin":[{"indexid":28729394,"indexTime":1792791424037,"id":"urn:usgs-product:us:origin:us7000tbwb:1792791413040","type":"origin","code":"us7000tbwb","source":"us","updateTime":1792791413040,"status":"UPDATE","properties":{"depth":"0","error-ellipse-azimuth":"221","error-ellipse-intermediate":"17359","error-ellipse-major":"23856","error-ellipse-minor":"2951","error-ellipse-plunge":"0","error-ellipse-rotation":"88","evaluation-status":"confirmed","event-type":"landslide","eventParametersPublicID"